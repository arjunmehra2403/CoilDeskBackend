```gitignore
# Dependencies
node_modules/

# Environment variables / Secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Build output
dist/
build/
coverage/

# Cache
.cache/
.npm/
.eslintcache/

# Uploads (if stored locally)
uploads/
temp/
tmp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.nyc_output/

# PM2
.pm2/

# Miscellaneous
*.local
```
